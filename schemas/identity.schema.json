{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allied-identity.local/schemas/identity.schema.json",
  "title": "Allied Identity profile",
  "description": "Rust 코어(AlliedID)와 C# 컴패니언(alliedid-companion)이 공유하는 인격체 프로필 형식.",
  "type": "object",
  "required": ["schema_version", "name", "persona", "principles", "memories"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string" },
    "name_ko": { "type": "string" },
    "callsign": { "type": "string" },
    "persona": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "tone": { "type": "string" },
        "language": { "type": "string", "description": "BCP 47 언어 코드 (예: ko, en)" }
      }
    },
    "principles": { "type": "array", "items": { "type": "string" } },
    "owner": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "created_at": { "type": "integer", "description": "UNIX 시각(초)" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
