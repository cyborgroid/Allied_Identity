{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allied-identity.local/schemas/net-report.schema.json",
  "title": "AlliedID network environment report",
  "description": "`AlliedID net --json` 과 `alliedid-companion net --json` 이 출력하는 네트워크 환경 보고서.",
  "type": "object",
  "required": ["source", "online", "interfaces"],
  "properties": {
    "source": { "type": "string", "description": "linux-sysfs | companion | probe-only" },
    "online": { "type": "boolean" },
    "reachable": { "type": "array", "items": { "type": "string" } },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "up"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["wifi", "ethernet", "cellular", "tethering", "vpn", "virtual", "other"] },
          "up": { "type": "boolean" },
          "addresses": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "wifi": {
      "type": ["object", "null"],
      "properties": {
        "ssid": { "type": "string" },
        "security": { "type": "string" },
        "signal": { "type": ["integer", "null"] },
        "open": { "type": "boolean" }
      }
    },
    "cellular": { "type": "array", "items": { "type": "string" }, "description": "감지된 셀룰러 모뎀" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
